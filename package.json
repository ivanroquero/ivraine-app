{
  "name": "ivraine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w backend",
    "typecheck": "tsc -p frontend/tsconfig.json && tsc -p backend/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "test:browser": "node --import tsx tests/browser-check.ts",
    "test:push-browser": "node --import tsx tests/push-browser-check.ts",
    "test:proposal-browser": "node --import tsx tests/proposal-browser-check.ts",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "agent-browser": "0.38.0",
    "supabase": "^2.118.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
