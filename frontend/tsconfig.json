{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@api/*": ["../api/*"],
      "@api": ["../api/index"]
    }
  },
  "include": ["src", "vite.config.ts", "../api"]
}
