VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:3001
# Optional: Mapbox public token for custom vector dark/satellite maps (pk.eyJ...)
# If omitted, /admin automatically falls back to CartoDB dark tiles via Leaflet with 0 setup.
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...
# No trailing slash. NEVER put secret/service-role keys in VITE_ variables.
