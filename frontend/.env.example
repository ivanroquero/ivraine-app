# Copy to frontend/.env.local for local development.
# Add these three values to Vercel Environment Variables before building.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:3001
# Production API example: https://YOUR_SERVICE.up.railway.app
# No trailing slash. NEVER put secret/service-role keys in VITE_ variables.
