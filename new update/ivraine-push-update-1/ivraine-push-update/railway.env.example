# Railway backend environment; replace every placeholder, then redeploy.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FRONTEND_ORIGINS=https://YOUR_ACTUAL_VERCEL_DOMAIN
TRUST_PROXY_HOPS=1
NODE_ENV=production
# Railway supplies PORT. Keep this service awake for the delivery worker.
PUSH_DATABASE_URL=YOUR_SUPABASE_POSTGRES_SESSION_POOLER_CONNECTION_STRING
VAPID_PUBLIC_KEY=YOUR_GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_GENERATED_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_REAL_CONTACT_EMAIL
# Optional if your database TLS chain requires this CA:
# PUSH_DATABASE_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Generate one VAPID pair once: npm run push:keys -w backend
# Server secrets only: never commit a populated copy of this file.
