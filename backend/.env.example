# Copy to backend/.env for local development; use Railway Variables in production.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FRONTEND_ORIGINS=http://localhost:5173
# Production: https://YOUR_SITE.vercel.app,https://your-custom-domain.com
# Use exact origins without paths. No wildcard origins.
PORT=3001
TRUST_PROXY_HOPS=0
# Railway: set TRUST_PROXY_HOPS=1 behind its edge proxy; let Railway provide PORT.
NODE_ENV=development
# Railway: NODE_ENV=production
# No service-role secret and no DATABASE_URL are needed by this API.
