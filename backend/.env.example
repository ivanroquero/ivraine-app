# Copy to backend/.env for local development; use Railway Variables in production.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FRONTEND_ORIGINS=http://localhost:5173
# Production: https://YOUR_SITE.vercel.app,https://your-custom-domain.com
# Use exact origins without paths. No wildcard origins.
PORT=3001
TRUST_PROXY_HOPS=0
# Railway: set TRUST_PROXY_HOPS=1 behind its edge proxy; let Railway provide PORT.
NODE_ENV=development
# Railway: NODE_ENV=production
# Core scrapbook operations need no service-role secret. Optional push uses PUSH_DATABASE_URL below.

# OPTIONAL: enable saved hearts and reliable push delivery (Railway secrets only).
# Copy the session-pooler URL from Supabase Connect; percent-encode password characters.
# PUSH_DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Supply your database CA certificate as PEM if the TLS chain needs it. Never disable TLS checks.
# PUSH_DATABASE_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Generate one pair once with: npm run push:keys -w backend
# VAPID_PUBLIC_KEY=YOUR_GENERATED_PUBLIC_KEY
# VAPID_PRIVATE_KEY=YOUR_GENERATED_PRIVATE_KEY
# VAPID_SUBJECT=mailto:YOUR_REAL_CONTACT_EMAIL
# To leave push disabled, OMIT all of these variables instead of using placeholders.
